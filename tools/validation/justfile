# tools/validation — run every language module's linters/formatters.

set shell := ["bash", "-c"]

# Run all linters
all: python cpp

python:
    cd python && uv run ruff check . && uv run ruff format --check .

cpp:
    find cpp/src cpp/include cpp/test -name '*.cpp' -o -name '*.hpp' -o -name '*.h' | xargs clang-format --dry-run --Werror
