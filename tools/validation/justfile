# tools/validation — run every module's linters/formatters.

set shell := ["bash", "-c"]

# Run all linters
all: backend gui base

backend:
    cd backend && uv run ruff check . && uv run ruff format --check .

gui:
    cd gui && uv run ruff check . && uv run ruff format --check .

base:
    find base/src base/include base/tests -name '*.cpp' -o -name '*.hpp' -o -name '*.h' | xargs clang-format --dry-run --Werror
