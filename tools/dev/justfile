# tools/dev — environment setup and maintenance.

set shell := ["bash", "-c"]

# Set up every language module's dev environment
setup:
    @echo "Setting up dev environment..."
    cd python && uv sync --all-extras --dev
    pip install pre-commit || true
    pre-commit install --install-hooks || echo "pre-commit not available"
    @echo "Setup complete. Run 'just test' to verify."

# Update all dependencies
update:
    @echo "Updating dependencies..."
    cd python && uv sync --upgrade

# Run pre-commit hooks manually
pre-commit:
    pre-commit run --all-files

# Clean build artifacts across every module
clean:
    rm -rf python/.pytest_cache python/.ruff_cache python/.mypy_cache python/**/__pycache__
    rm -rf cpp/build
