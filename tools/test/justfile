# tools/test — run every module's test suite.

set shell := ["bash", "-c"]

# Run all test suites
all: backend gui base

backend:
    cd backend && uv run pytest test -v

gui:
    cd gui && uv run pytest test -v

base:
    cmake -S base -B base/build -DBUILD_TESTING=ON && cmake --build base/build -j && ctest --test-dir base/build --output-on-failure
