# =============================================================================
# Anime-Stitch-Pipeline Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# =============================================================================
# ASP Pipeline Feature Flags (all optional, unset = pipeline default)
# Boolean flags accept "0"/"1" unless noted. See moon/ROADMAP.md and
# moon/CHANGELOG.md for what each stage/gate does.
# =============================================================================
# ASP_GRAPHCUT_SEAM=1
# ASP_FG_REGISTER=1
# ASP_ARAP_PUSH=1
# ASP_BATCH_GPU=1
# ASP_GPU_MEDIAN=1
# ASP_GLOBAL_GAIN_COMP=1
# ASP_ADAPTIVE_RENDER_GAIN=1
# ASP_MASKED_MEDIAN=1
# ASP_FG_EXCLUDE_MEDIAN=1
# ASP_BG_AVERAGE=1
# ASP_HOLD_AVERAGE=1
# ASP_PHASE_AWARE_SELECT=1
# ASP_PHASE_COMPOSITE=1
# ASP_OTSU_BG_CORR=1
# ASP_DHASH_EXACT_DROP=1
# ASP_SIMILARITY_MODE=phash            # phash | dhash | ...
# ASP_DY_CV_MAX=1.5                    # dy_cv pre-detection gate threshold
# ASP_ALIGN_GATE_DX=<float>
# ASP_GAIN_DRIFT_MAX=<float>
# ASP_ZONE_MIN_HEIGHT=<int>
# ASP_GC_FEATHER_PX=<int>
# ASP_POSE_WINDOW_PX=<int>
# ASP_NEAR_DUP_LUMA=<float>
# ASP_TEMPORAL_VAR_THRESH=<float>
# ASP_BLUR_REJECT_THRESH=<float>
# ASP_CONTRAST_THRESH=<float>
# ASP_HOLD_THRESHOLD=<float>
# ASP_HOLD_DHASH_THRESH=<int>
# ASP_HIGH_HOLD_RESPONSE=1
# ASP_GATE_GHOST=<float>
# ASP_GATE_SEAM_VIS=<float>
# ASP_EXPERIMENT_LABEL=<string>        # tags benchmark output runs
# ASP_TEST_CUDA_CLEANUP=1              # gate CUDA VRAM flush in test fixtures

# =============================================================================
# General Configuration
# =============================================================================
APP_ENV=development                    # development, staging, production
APP_VERSION=latest                     # Docker image tag
DEBUG_MODE=false
LOG_LEVEL=INFO                         # DEBUG, INFO, WARNING, ERROR

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=app_db
DB_USER=postgres
DB_PASSWORD=your_db_password

# Aliases for Docker Compose compatibility
POSTGRES_HOST=${DB_HOST}
POSTGRES_PORT=${DB_PORT}
POSTGRES_DB=${DB_NAME}
POSTGRES_USER=${DB_USER}
POSTGRES_PASSWORD=${DB_PASSWORD}

# =============================================================================
# API / Backend
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_me
CORS_ALLOWED_ORIGINS=http://localhost:5173

# =============================================================================
# Frontend
# =============================================================================
VITE_API_BASE_URL=http://localhost:8000

# =============================================================================
# Observability
# =============================================================================
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
