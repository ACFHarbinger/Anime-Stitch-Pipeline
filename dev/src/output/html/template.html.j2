<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ title }}</title>
  <script src="https://unpkg.com/vis-network@9/standalone/umd/vis-network.min.js"></script>
  <style>
    body { margin: 0; font-family: system-ui, sans-serif; background: #0b0f14; color: #e6e6e6; }
    #graph { width: 100vw; height: 80vh; border-bottom: 1px solid #333; }
    #summary { padding: 12px 20px; }
    #summary h1 { font-size: 1.1rem; margin: 0 0 8px; }
    .violation { color: #ff6b6b; }
    .cycle { color: #ffd166; }
    ul { margin: 4px 0; padding-left: 20px; }
  </style>
</head>
<body>
  <div id="summary">
    <h1>{{ title }}</h1>
    <p>{{ node_count }} nodes, {{ edge_count }} edges, {{ violations|length }} layer violation(s), {{ cycles|length }} circular-dependency group(s).</p>
    {% if violations %}
    <p class="violation">Layer violations:</p>
    <ul>
      {% for v in violations %}
      <li class="violation">{{ v.edge.source_id }} → {{ v.edge.target_id }} ({{ v.source_layer }} → {{ v.target_layer }})</li>
      {% endfor %}
    </ul>
    {% endif %}
    {% if cycles %}
    <p class="cycle">Circular dependencies:</p>
    <ul>
      {% for cycle in cycles %}
      <li class="cycle">{{ cycle|join(" ⟲ ") }}</li>
      {% endfor %}
    </ul>
    {% endif %}
  </div>
  <div id="graph"></div>
  <script>
    const nodes = new vis.DataSet({{ nodes_json|safe }});
    const edges = new vis.DataSet({{ edges_json|safe }});
    const container = document.getElementById("graph");
    const data = { nodes, edges };
    const options = {
      nodes: { shape: "dot", size: 12, font: { color: "#e6e6e6" } },
      edges: { color: { color: "#556", highlight: "#ff6b6b" }, arrows: "to" },
      physics: { barnesHut: { gravitationalConstant: -8000, springLength: 120 } },
    };
    new vis.Network(container, data, options);
  </script>
</body>
</html>
